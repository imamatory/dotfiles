[user]
  name = Vadim Safonov
  email = imamatory@gmail.com
	signingkey = /Users/im-rbc/.ssh/id_ed25519_signing.pub

[pull]
	rebase = true

[credential]
  helper = cache

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
