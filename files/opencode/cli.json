{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.tab.previous": "ctrl+[",
    "session.tab.next": "ctrl+]"
  },
  "theme": {
    "name": "catppuccin-frappe"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "low"
  },
  "animations": true,
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"]
}
