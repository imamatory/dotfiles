# The next line updates PATH for CLI.
if [ -f '/Users/im/yandex-cloud/path.bash.inc' ]; then source '/Users/im/yandex-cloud/path.bash.inc'; fi

# The next line enables shell command completion for yc.
if [ -f '/Users/im/yandex-cloud/completion.zsh.inc' ]; then source '/Users/im/yandex-cloud/completion.zsh.inc'; fi

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/im-rbc/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit
# End of Docker CLI completions
export PATH=/opt/homebrew/opt/libpq/bin:$PATH
# GNU utils without the "g" prefix
for pkg in coreutils findutils gnu-sed gnu-tar grep gawk; do
  export PATH=/opt/homebrew/opt/$pkg/libexec/gnubin:$PATH
done
unset pkg

# Reload SSH keys from the macOS keychain into launchd's ssh-agent (empty after reboot)
if [[ $OSTYPE == darwin* ]]; then
  ssh-add --apple-load-keychain 2>/dev/null
fi
