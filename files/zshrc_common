export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANGUAGE=en_US:en
export EDITOR="nvim"
export BAT_THEME="1337"

# One copy of each dir: login and nested shells prepend the same entries again.
typeset -U path fpath

[[ -f ~/.zsh_vars ]] && source ~/.zsh_vars
# Login shells (terminal tabs, tmux panes) have read ~/.zprofile already.
[[ -o login ]] || { [[ -f ~/.zprofile ]] && source ~/.zprofile }

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
# SHARE_HISTORY: panes write and read history as commands run, not on exit.
# zsh-autosuggestions reads this history; atuin keeps its own (Ctrl-R).
setopt EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY

# OMZ tmux plugin: keep the TERM that tmux sets.
export ZSH_TMUX_FIXTERM=false

if [[ "$OSTYPE" == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
path=("$PNPM_HOME/bin" "$HOME/.local/bin" $path "$HOME/.cargo/bin")

export DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib:$DYLD_FALLBACK_LIBRARY_PATH

# Completions: add every fpath entry here, before the single compinit, which
# runs in zinit's turbo block (zsh/plugins.sh). These dirs are filled by
# misecompsync and `mise completion zsh --install`.
fpath=("$HOME/.local/share/mise-completions/zsh" "$HOME/.local/share/zsh/site-functions" $fpath)
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=("$HOME/.docker/completions" $fpath)
# End of Docker CLI completions

source $HOME/dotfiles/zsh/plugins.sh
source $HOME/dotfiles/zsh/aliases.sh
source $HOME/dotfiles/zsh/fzf.sh

(( $+commands[starship] )) && eval "$(starship init zsh)"
eval "$(mise activate zsh)"

path=(/opt/homebrew/opt/libpq/bin $path)
# GNU utils without the "g" prefix
for pkg in coreutils findutils gnu-sed gnu-tar grep gawk; do
  path=(/opt/homebrew/opt/$pkg/libexec/gnubin $path)
done
unset pkg

# SSH keys come from the macOS keychain on first use (UseKeychain and
# AddKeysToAgent in files/ssh_config), so no ssh-add at startup.

# Ctrl-R: atuin history search (overrides fzf's). Up arrow stays zsh's own.
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow)"
# z / zi: jump to frecent dirs. Keep last: zoxide must see the final chpwd hooks.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
