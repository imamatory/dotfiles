export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANGUAGE=en_US:en
export ES_TMPDIR="/opt/homebrew/var/lib/elasticsearch/tmp"
export EDITOR="nvim"
export BAT_THEME="1337"
export FZF_DEFAULT_OPTS=' --color light'

export K9SCONFIG='~/.k9s/config.yml'

[ -n "${ZSH_VERSION-}" ] || return 0

[ -f ~/.zsh_vars ] && source ~/.zsh_vars
[ -f ~/.zprofile ] && source ~/.zprofile

set -o vi

DISABLE_AUTO_UPDATE=true
HIST_IGNORE_ALL_DUPS=true
HISTSIZE=1000
SAVEHIST=1000

eval "$(direnv hook zsh)"

# prevents overriding of TERM in tmux
export ZSH_TMUX_FIXTERM=false
export ZSH_TMUX_TERM=screen-256colour

bindkey '^[^ ' autosuggest-execute
bindkey "\C- " autosuggest-accept

export PATH=$PATH:~/.cargo/bin

export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

if [[ "$OSTYPE" == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
export PATH="$PNPM_HOME/bin:$PATH"

export DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib:$DYLD_FALLBACK_LIBRARY_PATH
export LD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib:$LD_LIBRARY_PATH

# finished completion files written by misecompsync and `mise completion zsh --install`
fpath=("$HOME/.local/share/mise-completions/zsh" "$HOME/.local/share/zsh/site-functions" $fpath)

if [[ -o interactive ]]; then
  autoload -Uz compinit
  compinit
fi

source $HOME/dotfiles/zsh/plugins.sh
source $HOME/dotfiles/zsh/aliases.sh
source $HOME/dotfiles/zsh/fzf.sh

# Bypass any zinit shim; prefer the Homebrew binary on mac.
if (( $+commands[starship] )); then
  starship_bin=/opt/homebrew/bin/starship
  [[ -x $starship_bin ]] || starship_bin=${commands[starship]}
  eval "$($starship_bin init zsh)"
fi

autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

eval "$(mise activate zsh)"

# export PYENV_ROOT="$HOME/.pyenv"
# [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
# eval "$(pyenv init - zsh)"

